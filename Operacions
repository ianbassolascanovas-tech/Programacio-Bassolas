nom1= input("introdueix el primer numero: ")
nom2= input("introdueix el segon numero: ")

print("OPERACIONS MATEMATIQUES")
print("La suma dels dos numeros es: ", int(nom1) + int(nom2))
print("La resta dels dos numeros es: ", int(nom1) - int(nom2))
print("La multiplicacio dels dos numeros es: ", int(nom1) * int(nom2))
print("La divisió dels dos numeros es: ", int(nom1) / int(nom2))
print("La divisió entera es: ", int(nom1) // int(nom2))
print("El modul és: ", int(nom1) % int(nom2))
print("La potencia és: ", int(nom1) ** int(nom2))

